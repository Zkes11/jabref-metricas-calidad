<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtros para SpotBugs.
  JabRef genera código en src/generated y usa clases JavaFX que generan muchos
  falsos positivos. Acá listamos los patrones a ignorar.
  Más info: https://spotbugs.readthedocs.io/en/latest/filter.html
-->
<FindBugsFilter>
    <!-- Ignorar código generado automáticamente -->
    <Match>
        <Source name="~.*src[\\/]generated[\\].*"/>
    </Match>
    <Match>
        <Class name="~.*\._pb_.*"/>
    </Match>

    <!-- Ignorar código de tests -->
    <Match>
        <Class name="~.*Test"/>
    </Match>
    <Match>
        <Source name="~.*src[\\/]test[\\].*"/>
    </Match>

    <!-- Falsos positivos comunes en código JavaFX -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~.*ViewModel.*"/>
    </Match>

    <!-- Patrones de baja prioridad a ignorar por ahora -->
    <Match>
        <Bug category="MALICIOUS_CODE"/>
        <Rank value="20"/>
    </Match>
</FindBugsFilter>
